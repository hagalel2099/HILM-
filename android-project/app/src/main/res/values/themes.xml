<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NossoUniverso.Wallpaper" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#B305080D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.NossoUniverso.Settings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#06090F</item>
        <item name="android:statusBarColor">#06090F</item>
        <item name="android:navigationBarColor">#06090F</item>
        <item name="colorPrimary">@color/hud_cyan</item>
        <item name="colorSecondary">@color/hud_amber</item>
    </style>
</resources>
