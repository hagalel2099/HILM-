<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0070B12"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtDrawerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aplicativos Instalados"
        android:textColor="@color/hud_cyan"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editSearchApps"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="#121A28"
        android:hint="@string/drawer_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/hud_text_primary"
        android:textColorHint="@color/hud_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtRecentHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/recent_apps_header"
        android:textColor="@color/hud_amber"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecentApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />
</LinearLayout>
