<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090F"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/hud_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDefaultStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/hud_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSetDefaultLauncher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/hud_cyan"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:singleLine="false"
            android:text="@string/set_default_launcher"
            android:textColor="#05080D"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/theme_section"
            android:textColor="@color/hud_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioLauncherTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbThemeDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="@string/theme_default_title"
                android:textColor="@color/hud_text_primary" />

            <RadioButton
                android:id="@+id/rbThemeLuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="@string/theme_luna_title"
                android:textColor="@color/luna_white_blue" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/icon_pack_section"
            android:textColor="@color/hud_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSettingsActivePack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12.5sp" />

        <Button
            android:id="@+id/btnOpenIconPackManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#13233A"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:singleLine="false"
            android:text="@string/manage_icon_packs"
            android:textColor="@color/hud_cyan"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioIconPacks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hud_transparency_section"
            android:textColor="@color/hud_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="70" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/transitions_section"
            android:textColor="@color/hud_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTransitionAccessibilityNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1A263B"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="@string/transitions_accessibility_note"
            android:textColor="@color/hud_amber"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchTransitionsEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/transitions_enable_label"
            android:textColor="@color/hud_text_primary"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/radioTransitionEffects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/txtTransitionDurationValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12.5sp" />

        <SeekBar
            android:id="@+id/seekTransitionDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="42" />

        <com.nossouniverso.launcher.ui.views.TransitionPreviewView
            android:id="@+id/transitionPreviewStage"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtTransitionPreviewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPreviewTransition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#13233A"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:singleLine="false"
                android:text="@string/transitions_preview_test"
                android:textAllCaps="false"
                android:textColor="@color/hud_cyan"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnApplyTransition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/hud_cyan"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:singleLine="false"
                android:text="@string/transitions_apply"
                android:textAllCaps="false"
                android:textColor="#05080D"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/transitions_android_scope_note"
            android:textColor="@color/hud_text_secondary"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/backup_section"
            android:textColor="@color/hud_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExportBackup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#13233A"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="52dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:singleLine="false"
                android:text="@string/export_backup_json"
                android:textAllCaps="false"
                android:textColor="@color/hud_cyan"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnImportBackup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#13233A"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="52dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:singleLine="false"
                android:text="@string/import_backup_json"
                android:textAllCaps="false"
                android:textColor="@color/hud_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnResetShortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:backgroundTint="#1E293B"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:singleLine="false"
            android:text="@string/reset_shortcuts"
            android:textColor="@color/hud_amber" />
    </LinearLayout>
</ScrollView>
