<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090F"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_pack_manager_title"
                android:textColor="@color/hud_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtActivePackSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hud_cyan"
                android:textSize="12.5sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackFromPacks"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#1E293B"
            android:text="@string/close_label"
            android:textColor="@color/hud_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRestoreOriginalIcons"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#1E293B"
        android:text="@string/restore_original_icons"
        android:textColor="@color/hud_amber"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerIconPacks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
